{
  "name": "@mistcash/sdk",
  "version": "0.6.0",
  "description": "Modular TypeScript SDK for MIST private payments on EVM. Extracted from core-deploy/playground.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./prover": {
      "types": "./dist/prover.d.ts",
      "node": "./dist/prover.node.js",
      "default": "./dist/prover.js"
    },
    "./mist.wasm": "./wasm/mist.wasm",
    "./circuit.json": "./circuit.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "circuit.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "sync:wasm": "node scripts/sync-wasm.mjs",
    "dev": "tsup --watch",
    "prepack": "node scripts/prepack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "viem": "^2.48.8",
    "vitest": "^3.2.4"
  }
}